# QuantLab edge behind an AWS network load balancer (#19, ADR-0012). It is the same edge
# as infra/edge/Caddyfile (ADR-0008) with two differences. TLS is terminated by the NLB
# (ACM certificate), so Caddy serves plain HTTP on :8080 inside the VPC. And the client's
# address arrives in a PROXY protocol v2 header from the NLB rather than as the TCP peer.
#
# The proxy_protocol listener wrapper replaces the connection's remote address with the
# one in the PROXY header, but only for connections from QUANTLAB_EDGE_PROXY_CIDRS (the
# NLB's subnets). `fallback_policy reject` makes a connection from any other source that
# sends a PROXY header fail (400), so no other host can claim an address. A connection
# from another source without a PROXY header is served with its own peer address. Only
# the NLB can connect at all (the edge's security group admits only the NLB's group).
# {remote_host} below is therefore the real client, and it overwrites X-Forwarded-For
# exactly as in compose.
#
# Checked locally with Caddy 2.10.2 (`caddy adapt`, `caddy validate`, and the PROXY
# protocol behaviour above): ./check-proxy-protocol.sh. NOT verified behind a real NLB,
# which is part of the #39 gate (README.md, "Validation").
{
	admin off
	# Never autosave the running config: it contains the edge secret (#39).
	persist_config off
	auto_https off
	servers :8080 {
		listener_wrappers {
			proxy_protocol {
				timeout 5s
				allow {$QUANTLAB_EDGE_PROXY_CIDRS}
				fallback_policy reject
			}
		}
		timeouts {
			read_header 10s
			read_body 5m
			idle 2m
		}
	}
}

:8080 {
	# Largest API body: 110 MiB, as in limits.py and route.ts.
	request_body {
		max_size 110MiB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy {$QUANTLAB_EDGE_UPSTREAM} {
		# The client address is the PROXY-stated peer, whatever the client claims.
		header_up X-Forwarded-For {remote_host}
		header_up -Forwarded
		header_up -X-Real-IP
		header_up X-QuantLab-Edge {$QUANTLAB_EDGE_SECRET}
	}
}
