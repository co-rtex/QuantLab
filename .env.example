# QuantLab settings: copy to .env (gitignored) and fill in. The API, workers and reaper
# read QUANTLAB_* from the environment or .env; docker compose substitutes the same .env.
# Defaults and every check: services/api/src/quantlab_api/config.py, docs/RUNBOOK.md.
#
# PUBLIC EXPOSURE IS PROHIBITED UNTIL #39 IS CLOSED. Every port binds to 127.0.0.1. Reach
# a deployment only through the TLS edge (infra/edge/compose.yml), and never publish the
# web tier, the API, Postgres, Redis, Prometheus, Grafana or Jaeger directly. See
# docs/RUNBOOK.md, "Exposing a deployment".

# development (the default; serves the API docs, no production guards), test, or production.
# The edge overlay (infra/edge/compose.yml) always runs production, whatever this says.
QUANTLAB_ENVIRONMENT=development

# --- Required in production (each process refuses to start without it) ---------------
# Generate real values; never commit them. `openssl rand -hex 32` and so on.
QUANTLAB_COOKIE_SECURE=false            # true in production
QUANTLAB_JWT_SECRET=                    # API only; 32+ characters, no placeholder words
QUANTLAB_METRICS_TOKEN=                 # API, metrics-serving workers, reaper; 16+ characters
QUANTLAB_REDIS_PASSWORD=                # 16+ characters; hex is safe inside the Redis URL

# --- The TLS edge (infra/edge/compose.yml) --------------------------------------------
QUANTLAB_EDGE_SECRET=                   # 32+ characters (Caddy refuses less)
# QUANTLAB_EDGE_BIND=127.0.0.1          # keep 127.0.0.1 until #39 is closed
# Peers allowed to state the client address. Compose sets ["web"]; elsewhere set the web
# tier's address, or production logins fail closed with 503 edge_required.
# QUANTLAB_TRUSTED_PROXIES=["web"]

# --- Capacity (docs/RUNBOOK.md, "Resources" and "503 server_busy") --------------------
# QUANTLAB_API_WORKERS=2                # API processes
# QUANTLAB_API_MEMORY=1880M             # the API container's limit; 4 processes need 2560M
# QUANTLAB_HEAVY_REQUESTS_PER_PROCESS=1 # optimize and the portfolio ledger, at once
# QUANTLAB_RATE_LIMIT_OPTIMIZE_PER_MINUTE=10
# QUANTLAB_WORKERS=2                    # worker replicas, 1536 MiB each

# --- Optional ---------------------------------------------------------------------------
# QUANTLAB_ANTHROPIC_API_KEY=           # the assistant's model; without it, answers are assembled
# QUANTLAB_MARKET_DATA_PROVIDER=        # licensed market data: inert unless provider, key,
# QUANTLAB_MARKET_DATA_API_KEY=         # licence and plan are all set (RUNBOOK)
